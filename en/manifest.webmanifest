{
  "name": "OpenCAD STEP Viewer",
  "short_name": "STEP Viewer",
  "description": "Open STEP and STP 3D files in a free online viewer. Inspect AP203, AP214 and AP242 assemblies, part colors and units, measure distances, and save PNG images. No installation; files are processed locally in your browser.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "../",
  "display": "standalone",
  "theme_color": "#232830",
  "background_color": "#232830",
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".stp",
            ".step",
            ".p21",
            ".stpz",
            ".gz",
            ".zip",
            "model/step",
            "application/step",
            "application/octet-stream",
            "application/zip",
            "application/gzip"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/step": [
          ".stp",
          ".step",
          ".p21"
        ],
        "application/octet-stream": [
          ".stp",
          ".step",
          ".p21",
          ".stpz"
        ],
        "application/gzip": [
          ".gz"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
