{
  "name": "opencad-step",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCAD STEP 뷰어·해석기: STEP(AP203·AP214·AP242) B-rep을 브라우저에서 삼각화해 3D로 보기",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --port 4402",
    "build": "tsc --noEmit && vite build && npm run check:seo && npm run check:i18n",
    "preview": "vite preview --port 4402",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:seo": "opencad-site check-seo",
    "test:seo": "opencad-site test-seo",
    "update:content-dates": "vite build && opencad-site update-content-dates",
    "check:i18n": "opencad-site check-i18n",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "sweep": "node scripts/sweep/sweep.mjs",
    "sweep:compare": "node scripts/sweep/compare.mjs"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "opencad-viewer3d": "github:GyuTae-Kim/opencad-viewer3d#d0cee96760e5b4d1a715d44f1141895b761ec2bc"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "22.1.0",
    "opencad-site-kit": "github:GyuTae-Kim/opencad-site-kit#v0.1.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12"
  }
}
