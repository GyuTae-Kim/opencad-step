{
  "name": "OpenCAD STEP Viewer",
  "short_name": "STEP-Viewer",
  "description": "Dies ist ein kostenloser STEP-Viewer, der STEP·STP-3D-CAD-Dateien ohne Installation öffnet. Überprüfen Sie die Baugruppenstruktur, die Teilefarbe und die Einheiten der Modelle AP203, AP214 und AP242 und messen Sie den Abstand oder speichern Sie ihn als PNG. Die Datei wird vom Browser verarbeitet.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./",
  "scope": "../",
  "display": "standalone",
  "theme_color": "#232830",
  "background_color": "#232830",
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".stp",
            ".step",
            ".p21",
            ".stpz",
            ".gz",
            ".zip",
            "model/step",
            "application/step",
            "application/octet-stream",
            "application/zip",
            "application/gzip"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/step": [
          ".stp",
          ".step",
          ".p21"
        ],
        "application/octet-stream": [
          ".stp",
          ".step",
          ".p21",
          ".stpz"
        ],
        "application/gzip": [
          ".gz"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
